# SPDX-License-Identifier: GPL-2.0
# Phone boot-menu fragment for Qualcomm Snapdragon devices.
#
# Apply on top of board/qualcomm/qcom-phone.config when targeting a
# phone build that should boot into the on-screen phonemenu and surface
# the QR diagnostic. Distinct from qcom-phone.config so reference boards
# (db845c, qcs615, qcs8300) opt in only by selecting this fragment.

# Phone-form-factor boot menu, rendered on the framebuffer and mirrored
# over serial / usb-acm.
CONFIG_CMD_PHONEMENU=y

# Top-of-screen inset so the header sits below the rounded corners /
# camera cutout (one font row pushes past blueline / crosshatch / sargo).
CONFIG_PHONE_TOP_INSET_LINES=1

# `pause` is used by the menu to keep status screens on display.
CONFIG_CMD_PAUSE=y

# Auto-render a diagnostic QR code at bootmenu entry so a board that
# loses serial / video on bring-up can still be identified by a phone
# scan. Pulls in LIB_QRCODE from the (separately maintained) qrcode
# series.
CONFIG_LIB_QRCODE=y
CONFIG_BOOTMENU_QR_DIAG=y

# Boot Android boot.img off eMMC/UFS automatically via bootflow:
# BOOTMETH_ANDROID pulls in ANDROID_BOOT_IMAGE + CMD_ABOOTIMG + CMD_BCB;
# ANDROID_AB lets the bootloader honour the slot the system selected
# (otherwise we'd boot slot a on every A/B-managed phone).
CONFIG_BOOTMETH_ANDROID=y
CONFIG_ANDROID_AB=y

# USB Ethernet gadget (RNDIS) so the phone shows up as a network
# interface on the host, enabling tftpboot / pxe boot. RNDIS rather
# than CDC-ECM because Windows hosts only support RNDIS out of the
# box; Linux/macOS accept both.
CONFIG_USB_ETHER=y
CONFIG_USB_ETH_RNDIS=y

# Suppress the boot-time "Net:   No ethernet found." banner. The
# usb_ether gadget still binds on demand when the user opts into
# TFTP / PXE boot from the menu.
CONFIG_NET_SKIP_BOOT_INIT=y

# Carry the previous bootloader's /chosen/bootargs into $bootargs so
# the menu can display the cmdline ABL prepared and the user can hand
# it through unchanged.
CONFIG_SAVE_PREV_BL_BOOTARGS=y
